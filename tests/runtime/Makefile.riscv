# Makefile for RISC-V version of sysy-runtime

CC := riscv64-linux-gnu-gcc
AR := riscv64-linux-gnu-ar
RANLIB := riscv64-linux-gnu-ranlib

CFLAGS := -Wall -Werror -static -march=rv64im -mabi=lp64 -O3 -DNO_LIBC
ARFLAGS := rc

TOP_DIR := $(shell pwd)
SRC_DIR := $(TOP_DIR)/src
BUILD_DIR := $(TOP_DIR)/build
OBJ_DIR := $(BUILD_DIR)/obj

SRCS := $(SRC_DIR)/sysy.c
SRCS += $(wildcard $(SRC_DIR)/nolibc/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c, $(OBJ_DIR)/%.o, $(SRCS))
OBJS := $(patsubst $(SRC_DIR)/nolibc/%.c, $(OBJ_DIR)/nolibc/%.o, $(OBJS))
LIBSYSY := $(BUILD_DIR)/libsysy.a

.PHONY: all clean

all: $(LIBSYSY)

$(LIBSYSY): $(OBJS)
	mkdir -p $(dir $@)
	$(AR) $(ARFLAGS) $@ $^
	$(RANLIB) $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ -I$(SRC_DIR) -c

$(OBJ_DIR)/nolibc/%.o: $(SRC_DIR)/nolibc/%.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $^ -o $@ -I$(SRC_DIR) -c

clean:
	-rm -rf $(BUILD_DIR)
